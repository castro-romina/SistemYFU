model Voluntario {
  id             String        @id @default(cuid())
  nombre         String
  email          String        @unique
  password       String
  
  // Step 1
  fechaNacimiento DateTime?
  pais           String?
  telefono       String?
  ciudad         String?
  comoSeEntero   String?
  
  // Step 2
  fotoPerfil     String?
  acercaDe       String?
  carrera        String?
  genero         String?
  linkedin       String?
  
  // Step 3
  habilidades    String?      // Cambié de String[] a String?
  experiencia    String?
  horasPorSemana String?
  disponibilidad String?      // Cambié de String[] a String?
  
  // Legacy
  intereses      String[]      @default([])
  
  createdAt      DateTime      @default(now())
  postulaciones  Postulacion[]
}