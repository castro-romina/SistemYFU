generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Fundacion {
  id            String   @id @default(cuid())
  nombre        String
  email         String   @unique
  password      String
  descripcion   String?
  createdAt     DateTime @default(now())
  tareas        Tarea[]

  tipo          String?
  pais          String?
  ciudad        String?
  telefono      String?
  logo          String?
  mision        String?
  sitioWeb      String?
  linkedin      String?
  instagram     String?
  areasTrabajo  String[] @default([])
  cuit          String?
}

model Voluntario {
  id              String        @id @default(cuid())
  nombre          String
  email           String        @unique
  password        String

  // Step 1
  fechaNacimiento DateTime?
  pais            String?
  telefono        String?
  ciudad          String?
  comoSeEntero    String?

  // Step 2
  fotoPerfil      String?
  acercaDe        String?
  carrera         String?
  genero          String?
  linkedin        String?

  // Step 3
  habilidades     String?
  experiencia     String?
  horasPorSemana  String?
  disponibilidad  String?

  intereses       String[]      @default([])

  createdAt       DateTime      @default(now())
  postulaciones   Postulacion[]
}

model Tarea {
  id            String        @id @default(cuid())
  titulo        String
  descripcion   String
  ubicacion     String?
  fecha         DateTime?
  activa        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  fundacionId   String
  postulaciones Postulacion[]
  fundacion     Fundacion     @relation(fields: [fundacionId], references: [id])
}

model Postulacion {
  id           String     @id @default(cuid())
  estado       String     @default("pendiente")
  createdAt    DateTime   @default(now())
  tareaId      String
  voluntarioId String
  tarea        Tarea      @relation(fields: [tareaId], references: [id])
  voluntario   Voluntario @relation(fields: [voluntarioId], references: [id])

  @@unique([tareaId, voluntarioId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  usado     Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}